# NWA API — environment contract (Day 1).
# Every var below is REQUIRED and Zod-validated at boot: a missing or
# malformed value fails the process fast (src/env.ts), never a half-booted
# server. Copy to `.env`, fill real values. `.env` is gitignored.
#
# Vars marked [Day N] are reserved now (contract locked once) but not
# exercised until that day; placeholders below let the scaffold boot today.

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Postgres (Day 0 lock #3: Supabase's bundled Postgres, app-owned access) ---
# Privileged app role on the Postgres connection string. No PostgREST / no
# Supabase client SDK for data / no RLS — authz is the API layer.
# Supabase direct connection (port 5432, session-mode — required for Day-2
# `SET LOCAL app.actor`). Do NOT append ?sslmode=... — TLS is driven by
# DATABASE_SSL_CA below, not the connection string.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# CA cert that signed the Postgres server cert. Supabase's direct connection
# uses Supabase's own CA (not in Node's trust store) — download it from
# dashboard → Project Settings → Database → SSL Configuration, save as
# api/certs/supabase-ca.crt. Verified TLS (rejectUnauthorized stays true);
# we teach Node the CA rather than disabling verification. Leave UNSET only
# for a bare local Postgres with no TLS.
DATABASE_SSL_CA=./certs/supabase-ca.crt

# --- Redis (server-side cache + rate limit + sessions) ---
REDIS_URL=redis://localhost:6379

# --- Supabase Auth (Day 0 lock #2: JWKS verify) — reserved, wired Day 2 ---
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_ISS=https://YOUR-PROJECT.supabase.co/auth/v1

# --- Stripe (test-mode keys in dev/staging) — reserved, wired Day 14/15 ---
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- Cloudflare R2 (private media) — reserved, wired Day 17 ---
R2_ACCOUNT_ID=placeholder
R2_ACCESS_KEY_ID=placeholder
R2_SECRET_ACCESS_KEY=placeholder
R2_BUCKET=nwa-media-dev
