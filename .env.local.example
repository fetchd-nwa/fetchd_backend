# api/.env.local — developer-local overrides. Copy to `.env.local` and edit.
# Loaded BEFORE `.env` (env.ts:dotenvConfig({ path: '.env.local' })), so the
# values here take precedence per-key. Empty/unset keys fall through to
# `.env`. Gitignored (`api/.gitignore: .env.*`); this `.example` is tracked.
#
# Recommended use: pair with `docker compose up -d` (see docker-compose.yml
# at repo root) so the API hits a local Postgres + Redis instead of the
# staging Supabase project. Keeps contract tests reproducible when staging
# is paused / network-flaky / out-of-sync with `schema.sql`.

# --- LOCAL STACK -------------------------------------------------------
# These point at the docker-compose services (host-network forwarded).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# DATABASE_SSL_CA explicitly empty: local pg has no TLS. env.ts treats
# empty string as "no CA" (same as the var being unset). Required because
# `.env` likely sets DATABASE_SSL_CA to the Supabase CA path, and dotenv
# can only set vars — it can't unset them. Empty-here-wins-over-set-in-env
# is how we disable TLS without editing `.env`.
DATABASE_SSL_CA=

REDIS_URL=redis://localhost:6379

# --- DEV PRINCIPAL BYPASS (Day-7a) -------------------------------------
# When ON, a request with `X-Dev-Principal: owner:<uuid>` (or
# `staff:<uuid>:<role>`) constructs the Principal directly — no Supabase
# JWT needed. Unset = default ON in development/test, OFF in
# staging/production. NODE_ENV=production HARD-overrides to OFF
# regardless of this value (see env.ts:resolveBypassHeaderEnabled).
#
# Curl example (fixture owner from contract tests):
#   curl -H 'X-Dev-Principal: owner:11111111-1111-4111-8111-111111111111' \
#     http://localhost:3000/dogs
# BYPASS_HEADER_ENABLED=true

# --- EVERYTHING ELSE FALLS THROUGH TO `.env` ---------------------------
# JWKS / JWT / webhook / Stripe / R2 keys come from `.env` unchanged. The
# contract tests stub `authenticate` (no real JWT verify) and don't hit
# Stripe / R2 / the webhook — so whatever staging values are in `.env`
# work fine. Override here only if you need to test an integration with
# a different upstream (e.g., a local Stripe-mock).
